<!DOCTYPE html>
<html lang="en">
<%- include('partials/header.ejs') %>

<body>
    <h1 class="bs-info-rgb text-white text-center p-3 m-0">
        <a href="/" class="text-white text-decoration-none">Info Theater</a>
    </h1>

    <%- include('partials/navbar.ejs') %>

    <div class="container admin-page mt-5">
        <div class="admin-panel mx-auto p-4">

            <h2 class="text-center mb-3">Admin Panel</h2>
            <p class="text-center mb-4">
                Search for a user to manage their admin status and watchlist.
            </p>

            <form action="/admin" method="GET" class="mb-4">
                <div class="input-group">
                    <input
                        type="text"
                        class="form-control"
                        name="userSearch"
                        placeholder="Search by username"
                        value="<%= userSearch || '' %>"
                    >
                    <button class="btn btn-dark" type="submit">Search</button>
                </div>
            </form>

            <% if (foundUser) { %>
                <div class="user-result-card p-4">

                    <h4 class="mb-3">Username: <%= foundUser.username %></h4>

                    <form action="/admin/updateAdmin" method="POST">
                        <input type="hidden" name="userId" value="<%= foundUser.userId %>">
                        <input type="hidden" name="userSearch" value="<%= userSearch %>">

                        <div class="form-check form-switch mt-4">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="adminToggle"
                                name="isAdmin"
                                <%= foundUser.isAdmin ? "checked" : "" %>
                            >
                            <label class="form-check-label" for="adminToggle">
                                Admin privileges
                            </label>
                        </div>

                        <button class="btn btn-dark mt-3" type="submit">
                            Save Changes
                        </button>
                    </form>

                    <hr>

                    <h4 class="mt-4">User Watchlist</h4>

                    <% if (userWatchlist.length === 0) { %>
                        <p class="text-muted">This user has no movies in their watchlist.</p>
                    <% } else { %>
                        <% userWatchlist.forEach(movie => { %>
                            <div class="watchlist-item d-flex mb-3 p-3">
                                <img
                                    src="https://image.tmdb.org/t/p/w200<%= movie.posterPath %>"
                                    alt="<%= movie.title %>"
                                    class="watchlist-poster"
                                >

                                <div class="watchlist-info ms-4">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h5><%= movie.title %></h5>

                                        <form action="/admin/removeWatchlistMovie" method="POST">
                                            <input type="hidden" name="watchlistId" value="<%= movie.watchlistId %>">
                                            <input type="hidden" name="userSearch" value="<%= userSearch %>">
                                            <button class="btn btn-danger btn-sm" type="submit">X</button>
                                        </form>
                                    </div>

                                    <p><%= movie.overview || "No description available." %></p>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>

                    <hr>

                    <form action="/admin/deleteUser" method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');">
                        <input type="hidden" name="userId" value="<%= foundUser.userId %>">
                        <button class="btn btn-danger mt-3" type="submit">
                            Delete User
                        </button>
                    </form>

                </div>

            <% } else if (userSearch && userSearch.trim() !== "") { %>

                <p class="text-center text-danger">No user found.</p>

            <% } %>

        </div>
    </div>
</body>
<%- include('partials/footer.ejs') %>
</html>