<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <%- include('partials/header') %>

<body class="text-center">
    <h1 class="bs-info-rgb text-white text-center p-3 m-0">Edit Account Page</h1>
    <%- include('partials/navbar.ejs') %>
        <div class="mb-10">
            <form action="/edit-username" method="POST" class="w-25 m-auto">
                <input type="hidden" name="user" value="<%= user %>">
                New Username:
                <div class="loginDiv">
                    <input type="text" name="username" value="<%= user.username %>">
                    <span class="bi bi-person loginIcon"></span>
                    <% if (errorusername) { %>
                        <br>
                        <span class="text-danger">Username already taken.</span>
                        <% } %>
                            <br><br>
                            <button type="submit" class="btn btn-primary">Edit username</button>
                </div><br><br>
            </form>
        </div>
        <div class="mb-10">
            <form action="/edit-password" method="POST" class="w-25 m-auto">
            <input type="hidden" name="user" value="<%= user %>">
            Old Password:
            <div class="loginDiv">
                <input type="password" id="oldpwd" name="oldpassword">
            </div><br><br>
            New Password:
            <div class="loginDiv">
                <input type="password" id="newpwd" name="newpassword">
                <% if (errorpassword) { %>
                    <br>
                    <span class="text-danger">Old password doesn't match.</span>
                    <% } %>
                        <br><br>
                        <button type="submit" class="btn btn-primary">Edit password</button>
            </div><br><br>
            </form>
        </div>
        <%- include('partials/footer.ejs') %>
</body>

</html>